# API Gateway (YARP) — единственная точка входа во все сервисы Techodist.
# Для локального запуска достаточно скопировать файл в .env.local.
VITE_API_BASE_URL=http://localhost:5100

# Confidential-клиент админ-панели в Identity (значения совпадают с OpenIddictDataSeeder).
# Секрет виден браузеру, поэтому допустим только dev-сценарий; для прода — отдельный BFF/прокси.
VITE_ADMIN_CLIENT_ID=techodist-admin-panel
VITE_ADMIN_CLIENT_SECRET=techodist-admin-panel-dev-secret
