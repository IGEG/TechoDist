{
  "annotations": { "list": [] },
  "description": "Золотые сигналы сервисов Techodist. Метрики приходят с эндпоинта /metrics каждого сервиса (OpenTelemetry Prometheus-экспортёр), поэтому у всех рядов один и тот же job/instance, а имя сервиса лежит в лейбле service (его проставляет scrape-конфиг Prometheus). Панель логов читает Loki, в сообщениях есть TraceId — из Grafana по нему можно открыть трейс в Jaeger.",
  "editable": true,
  "graphTooltip": 1,
  "links": [
    { "asDropdown": false, "icon": "external link", "targetBlank": true, "title": "Jaeger: поиск трейсов", "type": "link", "url": "http://localhost:16686" },
    { "asDropdown": false, "icon": "external link", "targetBlank": true, "title": "Alertmanager", "type": "link", "url": "http://localhost:9093" }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [ "techodist", "red", "otel" ],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": { "selected": true, "text": [ "All" ], "value": [ "$__all" ] },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(up{job!=\"prometheus\"}, service)",
        "includeAll": true,
        "label": "Сервис",
        "multi": true,
        "name": "service",
        "options": [],
        "query": { "query": "label_values(up{job!=\"prometheus\"}, service)", "refId": "TechodistServices" },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-3h", "to": "now" },
  "timezone": "browser",
  "title": "Techodist · Сервисы (RED)",
  "uid": "techodist-services",
  "version": 1,
  "weekStart": "monday",
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 7 } ] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "value_and_name" },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "count(up{job=~\"$service\"} == 1)", "instant": true, "legendFormat": "доступно", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "count(up{job=~\"$service\"})", "instant": true, "legendFormat": "зарегистрировано", "refId": "B" }
      ],
      "title": "Сервисы доступны",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 10 } ] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(http_server_request_duration_seconds_count{service=~\"$service\",http_response_status_code=~\"5..\"}[5m])) * 60", "instant": true, "legendFormat": "5xx в минуту", "refId": "A" }
      ],
      "title": "Ошибки 5xx, за минуту",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "value" }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(http_server_active_requests{service=~\"$service\"})", "instant": true, "legendFormat": "запросов", "refId": "A" }
      ],
      "title": "Запросы выполняются сейчас",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "value" }, "unit": "bytes" },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(dotnet_process_memory_working_set_bytes{service=~\"$service\"})", "instant": true, "legendFormat": "working set", "refId": "A" }
      ],
      "title": "Память процессов, всего",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 10, "lineWidth": 2 }, "unit": "reqps" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "options": { "legend": { "calcs": [ "mean", "max" ], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (service) (rate(http_server_request_duration_seconds_count{service=~\"$service\"}[5m]))", "legendFormat": "{{service}}", "refId": "A" }
      ],
      "title": "Трафик, запросов в секунду",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 10, "lineWidth": 2 },
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.05 } ] },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "options": { "legend": { "calcs": [ "mean", "max" ], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (service) (rate(http_server_request_duration_seconds_count{service=~\"$service\",http_response_status_code=~\"5..\"}[5m])) / clamp_min(sum by (service) (rate(http_server_request_duration_seconds_count{service=~\"$service\"}[5m])), 0.0001)", "legendFormat": "{{service}}", "refId": "A" }
      ],
      "title": "Доля ошибок 5xx",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 0, "lineWidth": 2 }, "unit": "s" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 7,
      "options": { "legend": { "calcs": [ "mean", "max" ], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.50, sum by (le, service) (rate(http_server_request_duration_seconds_bucket{service=~\"$service\"}[5m])))", "legendFormat": "p50 {{service}}", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum by (le, service) (rate(http_server_request_duration_seconds_bucket{service=~\"$service\"}[5m])))", "legendFormat": "p95 {{service}}", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.99, sum by (le, service) (rate(http_server_request_duration_seconds_bucket{service=~\"$service\"}[5m])))", "legendFormat": "p99 {{service}}", "refId": "C" }
      ],
      "title": "Задержка HTTP: p50 / p95 / p99",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 10, "lineWidth": 2 }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 8,
      "options": { "legend": { "calcs": [ "mean", "max" ], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (service) (http_server_active_requests{service=~\"$service\"})", "legendFormat": "{{service}}", "refId": "A" }
      ],
      "title": "Запросы выполняются сейчас",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 10, "lineWidth": 2 }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "id": 9,
      "options": { "legend": { "calcs": [ "mean", "max" ], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (service) (rate(dotnet_process_cpu_time_seconds_total{service=~\"$service\"}[5m]))", "legendFormat": "{{service}}", "refId": "A" }
      ],
      "title": "CPU процессов .NET, ядер",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 10, "lineWidth": 2 }, "unit": "bytes" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "id": 10,
      "options": { "legend": { "calcs": [ "mean", "max" ], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (service) (dotnet_process_memory_working_set_bytes{service=~\"$service\"})", "legendFormat": "{{service}}", "refId": "A" }
      ],
      "title": "Память процессов .NET, working set",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 28 },
      "id": 11,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        { "datasource": { "type": "loki", "uid": "loki" }, "expr": "{app=\"techodist\", service=~\"$service\"}", "refId": "A" }
      ],
      "title": "Логи: ${service}",
      "type": "logs"
    }
  ]
}
