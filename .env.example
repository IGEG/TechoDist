# =============================================================================
# Пример переменных окружения для локальной инфраструктуры (docker-compose).
# Скопируйте в .env и при необходимости измените. Реальный .env НЕ коммитим.
# =============================================================================

# --- PostgreSQL (каждая БД в своём контейнере, как в прод-микросервисной схеме) ---
POSTGRES_USER=techodist
POSTGRES_PASSWORD=techodist_dev_pwd

# --- Redis ---
REDIS_PASSWORD=

# --- RabbitMQ ---
RABBITMQ_USER=techodist
RABBITMQ_PASSWORD=techodist_dev_pwd

# --- Прочее ---
ASPNETCORE_ENVIRONMENT=Development

# --- Секреты Identity (ADR 0004). В Development уже заданы в appsettings.Development.json,
#     в prod/CI передаются как переменные окружения (двойное подчёркивание = секция конфигурации).
#     Jwt__SigningKey — HS256, не короче 32 байт; в прод-контуре вместо ключа ставится RSA-сертификат.
# Jwt__Issuer=http://localhost:5102
# Jwt__SigningKey=change-me-techodist-signing-key-0123456789
# Jwt__EncryptionKey=change-me-techodist-encryption-key-0123456789
# OpenIddict__AdminClientSecret=change-me-admin-panel-secret
# Bootstrap__AdminEmail=admin@techodist.local
# Bootstrap__AdminPassword=change-me-strong-password

# --- Наблюдаемость (ADR 0008) ---
# Логин в Grafana для docker-compose.observability.yml (по умолчанию admin / admin).
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin

# Адреса стека наблюдаемости для сервисов (секция Observability; двойное подчёркивание = вложенность).
# В Development значения уже заданы в appsettings.Development.json: строки нужны, только чтобы
# переопределить их (например, выключить Loki или OTLP вне локального стенда).
# Observability__OtlpEndpoint=http://localhost:4317
# Observability__LokiUri=http://localhost:3100
# Observability__TraceSamplingRatio=1
